{
  "name": "p2p-alert-guard",
  "version": "1.0.0",
  "description": "Stops fake bank-alert scams in Nigerian P2P crypto trades: zkTLS-proves the payment with Paystack before the seller releases crypto, and records the decision on zkVerify.",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/run.js",
    "verify-proof": "node scripts/verify-proof.js",
    "postinstall": "node build/patch-esm.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@reclaimprotocol/attestor-core": "5.1.6",
    "@reclaimprotocol/js-sdk": "5.8.3",
    "@reclaimprotocol/tls": "0.1.5",
    "ethers": "6.17.0",
    "snarkjs": "0.7.6"
  }
}